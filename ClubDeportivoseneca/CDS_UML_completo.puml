  + generarResumen() : String
}

note left of Competencia
  Clave: nombre + temporada.
  torneoDeLosCerros: LIGA, nómina = mínimo
  de jugadores, suspensión cada 3 amarillas.
  ascun: GRUPOS_Y_ELIMINACION, nómina = mínimo + 1,
  suspensión cada 2 amarillas.
end note

enum FormatoCompetencia {
  LIGA
  GRUPOS_Y_ELIMINACION
}

enum Fase {
  LIGA
  GRUPOS
  OCTAVOS
  CUARTOS
  SEMIFINAL
  FINAL
  + esEliminatoria() : boolean
  + esValidaPara(formato : FormatoCompetencia) : boolean
}

class InscripcionCompetencia {
  - competencia : Competencia {readOnly}
  - equipo : Equipo {readOnly}
  - nomina : List<Socio>
  ~ InscripcionCompetencia(competencia : Competencia, equipo : Equipo)
  + getCompetencia() : Competencia
  + getEquipo() : Equipo
  + getNomina() : List<Socio>
  + estaEnNomina(socio : Socio) : boolean
}

class FilaPosicion {
  - nombre : String {readOnly}
  - jugados : int
  - ganados : int
  - empatados : int
  - perdidos : int
  - aFavor : int
  - enContra : int
  + FilaPosicion(nombre : String)
  ~ registrar(favor : int, contra : int) : void
  + getNombre() : String
  + getPuntos() : int
  + getDiferencia() : int
}

Competencia "0..*" --> "1" DeporteConjunto
Competencia --> Categoria
Competencia --> FormatoCompetencia
Competencia "1" <--> "0..*" InscripcionCompetencia
InscripcionCompetencia "0..*" --> "1" Equipo
InscripcionCompetencia "0..*" --> "0..*" Socio : nomina
Competencia ..> FilaPosicion : tabla de posiciones

' Navegable en los dos sentidos (Competencia tiene la lista y el partido su competencia)
Competencia "1" *-- "0..*" PartidoCompetencia
PartidoCompetencia "0..*" --> "1" Equipo
PartidoCompetencia --> Fase
PartidoCompetencia "0..*" --> "0..*" Socio : alineacion

