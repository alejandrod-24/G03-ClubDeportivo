' -------------------- Persistencia (paquete persistencia) --------------------
' Persistencia es la fachada: carga y salva todo en datos/ usando una clase
' por grupo de datos. Entre archivos se referencia por clave (ej. login).

class Persistencia {
  + {static} CARPETA_POR_DEFECTO : String = "datos"
  - carpeta : File {readOnly}
  - personas : PersistenciaPersonas {readOnly}
  - deportes : PersistenciaDeportes {readOnly}
  - partidos : PersistenciaPartidos {readOnly}
  + Persistencia(carpeta : String)
  + Persistencia()
  + existenDatos() : boolean
  + cargar() : Club
  + salvar(club : Club) : void
  + cargarOCrear() : Club
}

class ArchivoTexto {
  + {static} SEPARADOR : String = ";"
  + {static} SEPARADOR_LISTA : String = ","
  + {static} procesar(archivo : File, accion : Consumer<String[]>) : void
  + {static} escribir(archivo : File, encabezado : String, lineas : List<String>) : void
  + {static} unir(campos : Object...) : String
  + {static} unirLista(valores : List<String>) : String
  + {static} separarLista(campo : String) : List<String>
  + {static} exigirCampos(campos : String[], cantidad : int) : void
  + {static} leerBooleano(campo : String) : boolean
}

class PersistenciaPersonas {
  + {static} ARCHIVO : String = "personas.txt"
  + cargar(club : Club, carpeta : File) : void
  + salvar(club : Club, carpeta : File) : void
}
class PersistenciaDeportes {
  + {static} DEPORTES : String = "deportes.txt"
  + {static} EQUIPOS : String = "equipos.txt"
  + {static} INSCRIPCIONES : String = "inscripciones_equipo.txt"
  + cargar(club : Club, carpeta : File) : void
  + salvar(club : Club, carpeta : File) : void
}
class PersistenciaPartidos {
  + {static} INTERNOS : String = "partidos_internos.txt"
  + {static} COMPETENCIAS : String = "competencias.txt"
  + {static} INSCRIPCIONES : String = "inscripciones_competencia.txt"
  + {static} PARTIDOS_COMPETENCIA : String = "partidos_competencia.txt"
  + {static} ESTADISTICAS : String = "estadisticas.txt"
  + cargar(club : Club, carpeta : File) : void
  - {static} crearEstadistica(c : String[]) : EstadisticaPartido
  - {static} socios(club : Club, campo : String) : List<Socio>
  - {static} logins(socios : List<Socio>) : String
  + salvar(club : Club, carpeta : File) : void
}
class PersistenciaInstalaciones <<pendiente>> {
  + cargar(club, carpeta)
  + salvar(club, carpeta)
}
class PersistenciaComercio <<pendiente>> {
  + cargar(club, carpeta)
  + salvar(club, carpeta)
}
class PersistenciaAdministracion <<pendiente>> {
  + cargar(club, carpeta)
  + salvar(club, carpeta)
}

Persistencia *-- PersistenciaPersonas
Persistencia *-- PersistenciaDeportes
Persistencia *-- PersistenciaPartidos
Persistencia *-- PersistenciaInstalaciones
Persistencia *-- PersistenciaComercio
Persistencia *-- PersistenciaAdministracion

Persistencia ..> Club
Persistencia ..> DatosIniciales : si no hay datos
PersistenciaPersonas ..> ArchivoTexto
PersistenciaDeportes ..> ArchivoTexto
PersistenciaPartidos ..> ArchivoTexto

note bottom of PersistenciaPartidos
  Orden de carga (cada grupo apunta a los anteriores):
  1. Personas  2. Deportes  3. Instalaciones
  4. Partidos y competencia  5. Comercio  6. Administración
  PersistenciaPartidos también guarda las competencias.
end note

