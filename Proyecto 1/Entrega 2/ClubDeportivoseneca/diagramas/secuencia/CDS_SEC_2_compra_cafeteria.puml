@startuml
' Club Deportivo Séneca - Secuencia 2: compra en la cafeteria (RF-SOC-15)
title Secuencia 2 - Compra en la cafeteria
hide footbox
skinparam shadowing false

actor Socio as U
participant ":MenuConsola" as M
participant ":Club" as C
participant ":VentaCafeteria" as V
participant "instalacion:InstalacionIndividual" as I
participant "socio:Socio" as S

U -> M : comprar (productos)
M -> C : consultarAlergenos(productos)
C --> M : alergenos
M --> U : muestra alergenos y pide confirmacion
U -> M : acepta, propina, puntos
M -> C : comprarEnCafeteria(productos, puntos, propina, acepta)
activate C
C -> V ** : new VentaCafeteria(...)
C -> V : agregarDetalle(producto, cantidad)
opt incluye bebida caliente
  C -> C : ingresoActualDe(socio)
  C -> I : restringeBebidaCaliente()
  alt esta en padel o tenis de mesa techada
    C --> M : excepcion "No se despachan bebidas calientes"
  else
    C -> S : tomarBebidaCaliente()
  end
end
C -> C : registrar venta y puntos (2%)
C --> M : venta
deactivate C
M --> U : desglose (impuesto 8% + propina)
@enduml
